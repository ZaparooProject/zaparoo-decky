{
  "name": "zaparoo-decky",
  "version": "0.1.0",
  "description": "Controller-native Zaparoo Core companion for Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": "python3 -m unittest discover tests",
    "lint:python": "ruff check main.py decky.pyi tests scripts && ruff format --check main.py decky.pyi tests scripts",
    "format:python": "ruff check --fix main.py decky.pyi tests scripts && ruff format main.py decky.pyi tests scripts",
    "check:python": "python3 -m compileall -q main.py tests scripts && pyright",
    "check": "pnpm typecheck && pnpm test && pnpm lint:python && pnpm check:python && pnpm test:backend && pnpm build",
    "package": "pnpm build && python3 scripts/package_plugin.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZaparooProject/zaparoo-decky.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "zaparoo",
    "nfc"
  ],
  "author": "The Zaparoo Project Contributors",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/ZaparooProject/zaparoo-decky/issues"
  },
  "homepage": "https://github.com/ZaparooProject/zaparoo-decky#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-router": "5.1.20",
    "@types/react-test-renderer": "19.1.0",
    "@types/webpack": "^5.28.5",
    "pyright": "1.1.412",
    "react": "19.2.8",
    "react-test-renderer": "19.2.8",
    "rollup": "^4.53.3",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode.react": "^4.2.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
